DefaultLanguageMissingError =
    <b>❌ Мову за замовчуванням не заповнено</b>

    <blockquote>ℹ️ Не вказано мову за замовчуванням: { lang }.</blockquote>
    .call = ❌ Мова за замовчуванням відсутня

DefaultLanguageDeletionForbiddenError =
    <b>❌ Неможливо видалити мову за замовчуванням</b>

    <blockquote>ℹ️ Мова за замовчуванням використовується в системі та не може бути видалена.</blockquote>
    .call = ❌ Неможливо видалити мову за замовчуванням

CoefficientTooSmallError =
    <b>❌ Відсоток занадто малий</b>

    <blockquote>ℹ️ Мінімально допустимий відсоток — { $min_percent }%.</blockquote>
    .call = ❌ Коефіцієнт занадто малий

CoefficientTooBigError =
    <b>❌ Відсоток занадто великий</b>

    <blockquote>ℹ️ Максимально допустимий відсоток — { $max_percent }%.</blockquote>
    .call = ❌ Коефіцієнт занадто великий

TimePeriodFromDateGreaterThanToDateError =
    <b>❌ Неправильний період</b>

    <blockquote>ℹ️ Дата початку періоду не може бути пізнішою за дату завершення.</blockquote>
    .call = ❌ Неправильний період

DecimalError =
    <b>❌ Введіть число</b>

IntegerError =
    <b>❌ Введіть ціле число</b>

HTMLValidationError =
    <b>❌ Помилка форматування HTML</b>
