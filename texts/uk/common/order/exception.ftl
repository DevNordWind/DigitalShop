OrderNotFoundError =
    <b>❌ Замовлення не знайдено</b>

    <blockquote>ℹ️ Запитуване замовлення не існує або було видалене.</blockquote>
    .call = ❌ Замовлення не знайдено

OrderPermissionDeniedError =
    <b>❌ Недостатньо прав</b>

    <blockquote>ℹ️ У вас немає прав для виконання цієї дії із замовленням.</blockquote>
    .call = ❌ Недостатньо прав

OrderCouponApplicationForbiddenError =
    <b>❌ Застосування купона заборонено</b>

    <blockquote>ℹ️ Купон можна застосувати лише до нового замовлення.</blockquote>
    .call = ❌ Купон недоступний

OrderCancellationForbiddenError =
    <b>❌ Скасування замовлення заборонено</b>

    <blockquote>ℹ️ Замовлення не можна скасувати в поточному статусі.</blockquote>
    .call = ❌ Скасування заборонено

OrderFailureForbiddenError =
    <b>❌ Переведення у статус «помилка» заборонено</b>

    <blockquote>ℹ️ Замовлення не можна позначити як невдале в поточному стані.</blockquote>
    .call = ❌ Помилка статусу

OrderExpirationForbiddenError =
    <b>❌ Завершення терміну заборонено</b>

    <blockquote>ℹ️ Замовлення не можна автоматично завершити (закінчення терміну недоступне в поточному стані або часі).</blockquote>
    .call = ❌ Завершення терміну заборонено

OrderConfirmationForbiddenError =
    <b>❌ Підтвердження замовлення заборонено</b>

    <blockquote>ℹ️ Замовлення не можна підтвердити в поточному стані.</blockquote>
    .call = ❌ Підтвердження заборонено

OrderAwaitingPaymentForbiddenError =
    <b>❌ Очікування оплати заборонено</b>

    <blockquote>ℹ️ Замовлення не можна перевести у статус очікування оплати з поточного стану.</blockquote>
    .call = ❌ Очікування оплати заборонено

OrderCurrencyChangeForbiddenError =
    <b>❌ Зміна валюти заборонена</b>

    <blockquote>ℹ️ Валюту замовлення не можна змінити після створення замовлення.</blockquote>
    .call = ❌ Валюта недоступна

OrderItemsAmountChangeForbiddenError =
    <b>❌ Зміна кількості товарів заборонена</b>

    <blockquote>ℹ️ Не можна змінити кількість товарів у поточному статусі замовлення.</blockquote>
    .call = ❌ Зміна кількості заборонена

OrderFreePaymentForbiddenError =
    <b>❌ Безкоштовна оплата неможлива</b>

    <blockquote>ℹ️ Цей спосіб оформлення недоступний для безкоштовного замовлення.</blockquote>
    .call = ❌ Безкоштовна оплата заборонена

OrderPaymentRequiredError =
    <b>❌ Потрібна оплата</b>

    <blockquote>ℹ️ Для завершення замовлення необхідно оплатити його.</blockquote>
    .call = ❌ Потрібна оплата

OrderAppliedCouponRequiredError =
    <b>❌ Потрібен купон</b>

    <blockquote>ℹ️ Для цього способу оформлення необхідно застосувати купон.</blockquote>
    .call = ❌ Потрібен купон
