CouponCodeTooLongError =
    <b>❌ Coupon code is too long</b>

    <blockquote>ℹ️ Maximum code length is { $max_length } characters.</blockquote>
    .call = ❌ Code is too long

CouponCodeTooShortError =
    <b>❌ Coupon code is too short</b>

    <blockquote>ℹ️ Minimum code length is { $min_length } characters.</blockquote>
    .call = ❌ Code is too short

CouponValidityCannotBeInPastError =
    <b>❌ Invalid validity period</b>

    <blockquote>ℹ️ A coupon's validity period cannot be set in the past.</blockquote>
    .call = ❌ Invalid validity period

CouponNotFoundError =
    <b>❌ Coupon not found</b>

    <blockquote>ℹ️ The requested coupon does not exist or has been deleted.</blockquote>
    .call = ❌ Coupon not found

CouponPermissionDeniedError =
    <b>❌ Insufficient permissions</b>

    <blockquote>ℹ️ You do not have permission to perform this action on coupons.</blockquote>
    .call = ❌ Insufficient permissions

CouponAlreadyExistsError =
    <b>❌ Coupon already exists</b>

    <blockquote>ℹ️ A coupon with this code already exists.</blockquote>
    .call = ❌ Coupon already exists

CouponAlreadyRevokedError =
    <b>❌ Coupon already revoked</b>

    <blockquote>ℹ️ This coupon has already been revoked.</blockquote>
    .call = ❌ Already revoked

CouponDiscountUnsupportedCurrencyError =
    <b>❌ Currency not supported</b>

    <blockquote>ℹ️ This coupon discount is not available for the selected currency.</blockquote>
    .call = ❌ Currency not supported

CouponAlreadyUsedByUserError =
    <b>❌ Coupon already used</b>

    <blockquote>ℹ️ You have already used this coupon.</blockquote>
    .call = ❌ Coupon already used

CouponRevokedError =
    <b>❌ Coupon revoked</b>

    <blockquote>ℹ️ This coupon has been revoked and is no longer valid.</blockquote>
    .call = ❌ Coupon revoked

CouponNotStartedError =
    <b>❌ Coupon is not active yet</b>

    <blockquote>ℹ️ This coupon is not active yet.</blockquote>
    .call = ❌ Coupon is not active yet

CouponExpiredError =
    <b>❌ Coupon expired</b>

    <blockquote>ℹ️ This coupon has expired.</blockquote>
    .call = ❌ Coupon expired
